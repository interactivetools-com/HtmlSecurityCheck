{
    "name": "itools/htmlsecuritycheck",
    "description": "Allowlist check for HTML that has to be printed unencoded, such as rich text from a WYSIWYG editor: rejects content that could run script, send the page's data to another host, or mislead the visitor, and never rewrites what it accepts",
    "keywords": ["php", "html", "html5", "security", "xss", "stored-xss", "xss-protection", "html-security", "css-injection", "wysiwyg", "rich-text", "tinymce", "ckeditor", "allowlist", "tokenizer", "html5lib", "html-sanitizer", "htmlpurifier"],
    "type": "library",
    "homepage": "https://github.com/interactivetools-com/HtmlSecurityCheck",
    "license": "MIT",
    "readme": "README.md",
    "support": {
        "issues": "https://github.com/interactivetools-com/HtmlSecurityCheck/issues",
        "source": "https://github.com/interactivetools-com/HtmlSecurityCheck"
    },
    "authors": [
        {
            "name": "interactivetools.com",
            "homepage": "https://interactivetools.com/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Itools\\HtmlSecurityCheck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Itools\\HtmlSecurityCheck\\Tests\\": "tests/",
            "Itools\\Standards\\": "tests/Integration/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-text"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "coverage": "Run the test suite with a line-coverage report (requires Xdebug)"
    }
}
